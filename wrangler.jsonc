{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "braindump",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "ai": { "binding": "AI" },
  "durable_objects": { "bindings": [{ "name": "AI_BUDGET", "class_name": "AiBudget" }] },
  "migrations": [{ "tag": "ai-budget-v1", "new_sqlite_classes": ["AiBudget"] }],
  "vars": { "AI_ENABLED": "true", "AI_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8" }
}
